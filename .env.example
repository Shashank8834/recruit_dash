# ---------------------------------------------------------------------------
# Deployment (host ports / container names)
# ---------------------------------------------------------------------------
# Defaults avoid colliding with the v1 stack, so both can run side by side
# during migration. Check `docker ps` before changing these.
STACK_PREFIX=recruitment-v2
BACKEND_HOST_PORT=3012
FRONTEND_HOST_PORT=3013
POSTGRES_HOST_PORT=5433

# ---------------------------------------------------------------------------
# Database (source of truth)
# ---------------------------------------------------------------------------
POSTGRES_USER=recruitment
POSTGRES_PASSWORD=change_me
POSTGRES_DB=recruitment

# Host is `recruitment-db` inside compose — a distinctive alias, because the
# generic name `postgres` collides with other projects on a shared network and
# resolves to the wrong server at random. Running locally, use localhost:5433.
DATABASE_URL=postgres://recruitment:change_me@recruitment-db:5432/recruitment

# ---------------------------------------------------------------------------
# Classification (Gemini)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key

# Model IDs get renamed and retired — if you see a 404 from the classifier,
# change it here rather than in code.
GEMINI_MODEL=gemini-3.5-flash

# Verdicts below this confidence become NEEDS_REVIEW and go to the review
# queue instead of being shown as a decision. Raise it to send more to humans.
CONFIDENCE_FLOOR=0.6

# ---------------------------------------------------------------------------
# Message chaining
# ---------------------------------------------------------------------------
# How long a sender must go quiet before their messages are treated as one
# complete submission. 60s catches the "job title / then the description"
# split; raise it if people in your chats type slowly.
BATCH_QUIET_SECONDS=60

# Hard cap on one batch, so continuous messaging can't defer work forever.
BATCH_MAX_WINDOW_SECONDS=600

# Earlier messages passed to the classifier as context for continuation detection.
CLASSIFIER_CONTEXT_MESSAGES=12

# Open roles considered per match. Raise only if you routinely have more open.
MATCH_JD_LIMIT=25

# ---------------------------------------------------------------------------
# Evolution API (WhatsApp)
# ---------------------------------------------------------------------------
# Point your Evolution instance's messages.upsert webhook at:
#   http://<backend-host>:3001/webhook/whatsapp
# If set, requests must carry this value in x-webhook-token, apikey, or
# Authorization: Bearer. Leave blank to accept unauthenticated webhooks.
EVOLUTION_WEBHOOK_TOKEN=

# Only ingest messages from these chats (comma-separated full JIDs). Evolution
# delivers ALL inbound traffic on the instance, so without this a personal DM
# becomes a candidate row. Leave blank to accept everything.
#   group JID:  120363412324850699@g.us
#   direct JID: 919812345678@s.whatsapp.net
INGEST_ALLOWED_CHATS=

# Migration aid. Evolution allows only ONE webhook URL per instance, so point
# Evolution at this stack and set this to the OLD n8n webhook to run both
# pipelines on identical live traffic. Fire-and-forget: never blocks or fails
# ingest. Unset once n8n is retired.
#   WEBHOOK_FORWARD_URL=http://n8n:5678/webhook/<your-n8n-webhook-id>
WEBHOOK_FORWARD_URL=

# ---------------------------------------------------------------------------
# Attachment extraction (resumes)
# ---------------------------------------------------------------------------
# Evolution sends webhooks with webhookBase64=false, so media must be fetched
# back by message id. Without these, PDFs and DOCX resumes reach the classifier
# as "[document: resume.pdf]" with no text — which is what sends them to review.
EVOLUTION_API_URL=http://evolution_api:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=your-instance-name

# Skip anything larger than this (MB) rather than pulling it into memory.
MEDIA_MAX_MB=15
# Hard cap on extracted characters fed to the classifier.
MEDIA_MAX_CHARS=20000

# Set to 1 while first wiring Evolution up: logs the reason and the raw payload
# whenever a webhook delivery is ignored. Turn it off once messages are flowing —
# it logs full message bodies.
WEBHOOK_DEBUG=0

# ---------------------------------------------------------------------------
# Worker tuning
# ---------------------------------------------------------------------------
WORKER_POLL_MS=5000
WORKER_CLAIM_LIMIT=5
SHEET_SYNC_MS=30000

# ---------------------------------------------------------------------------
# Google Sheets mirror (read-only copy of Postgres)
# ---------------------------------------------------------------------------
# Leave GOOGLE_SHEET_ID blank to disable mirroring entirely.
GOOGLE_SHEET_ID=your_spreadsheet_id_here

# Option A: the whole service account JSON as a string (best for Docker)
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com"}

# Option B: a path to the JSON key file instead
# GOOGLE_SERVICE_ACCOUNT_KEY=/app/service-account.json
# SERVICE_ACCOUNT_KEY_FILE=/path/on/host/to/service-account.json
