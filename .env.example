# ---------------------------------------------------------------------------
# Deployment (host ports / container names)
# ---------------------------------------------------------------------------
# Defaults avoid colliding with the v1 stack, so both can run side by side
# during migration. Check `docker ps` before changing these.
STACK_PREFIX=recruitment-v2
BACKEND_HOST_PORT=3012
FRONTEND_HOST_PORT=3013
POSTGRES_HOST_PORT=5433

# ---------------------------------------------------------------------------
# Database (source of truth)
# ---------------------------------------------------------------------------
POSTGRES_USER=recruitment
POSTGRES_PASSWORD=change_me
POSTGRES_DB=recruitment

# Host is `recruitment-db` inside compose — a distinctive alias, because the
# generic name `postgres` collides with other projects on a shared network and
# resolves to the wrong server at random. Running locally, use localhost:5433.
DATABASE_URL=postgres://recruitment:change_me@recruitment-db:5432/recruitment

# ---------------------------------------------------------------------------
# Classification (model provider)
# ---------------------------------------------------------------------------
# LLM_PROVIDER=gemini  -> Google's native API (schema enforced server-side)
# LLM_PROVIDER=openai  -> any OpenAI-compatible /chat/completions endpoint:
#                         Groq, OpenRouter, Cerebras, Together, local Ollama
LLM_PROVIDER=gemini

# --- Gemini -----------------------------------------------------------------
# Note the free-tier quota is PER GOOGLE CLOUD PROJECT, not per key. Minting a
# new key in the same project inherits the same exhausted 5 rpm; you need a new
# project, or billing.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash

# --- OpenAI-compatible ------------------------------------------------------
# Groq's free tier is far more generous than Gemini's on requests per minute,
# which is the dimension this workload actually hits.
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_API_KEY=gsk_...
#   LLM_MODEL=openai/gpt-oss-120b
#   LLM_MAX_RPM=25
#
# Model ids are retired regularly — llama-3.3-70b-versatile was the obvious
# Groq pick until it 404'd. Run `npm run llm:models` to list what the provider
# currently serves rather than trusting documentation.
#
# Other endpoints that work unchanged:
#   OpenRouter  https://openrouter.ai/api/v1
#   Cerebras    https://api.cerebras.ai/v1
#   Ollama      http://host.docker.internal:11434/v1   (no rate limit at all)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Requests per minute to the provider. Gemini's free tier allows 5 per model
# per PROJECT; Groq's free tier is roughly 30. Going over
# earns a 429 asking you to wait ~52s, so it is cheaper to simply pace.
#
# The budget is shared across processes via Postgres, so the API, the worker
# and one-shot scripts draw on one pool. Set just under the provider's real
# limit: window boundaries need slack and each retry takes a slot.
#
# Set 0 to disable once billing is enabled.
LLM_MAX_RPM=4

# Tokens per minute. Defaulted per provider, because the two free tiers fail
# in opposite directions:
#
#   openai-compatible (Groq)  6000   ~8000 TPM against 30 rpm, so one
#                                    classification's few thousand tokens
#                                    exhaust the token budget after about two
#                                    calls. This is the ceiling that binds.
#   gemini                    0      hundreds of thousands of tokens a minute
#                                    against 5 rpm per project, so LLM_MAX_RPM
#                                    does the work and a token ceiling would
#                                    only throttle a limit that never binds.
#
# Leave blank to take the per-provider default. Like LLM_MAX_RPM the budget is
# shared across processes via Postgres. Set 0 to disable on a paid tier.
#
# Sanity check when raising the character budgets below: one request must fit
# inside this ceiling on its own, or it can never be sent at all — the limiter
# rejects it immediately and the classifier re-renders it smaller.
LLM_MAX_TPM=

# Verdicts below this confidence become NEEDS_REVIEW and go to the review
# queue instead of being shown as a decision. Raise it to send more to humans.
CONFIDENCE_FLOOR=0.6

# ---------------------------------------------------------------------------
# Message chaining
# ---------------------------------------------------------------------------
# How long a sender must go quiet before their messages are treated as one
# complete submission. 60s catches the "job title / then the description"
# split; raise it if people in your chats type slowly.
BATCH_QUIET_SECONDS=60

# Hard cap on one batch, so continuous messaging can't defer work forever.
BATCH_MAX_WINDOW_SECONDS=600

# Earlier messages passed to the classifier as context for continuation detection.
CLASSIFIER_CONTEXT_MESSAGES=12

# Open roles considered per match, newest first. The n8n workflow this replaces
# matched against a single role ("Get Latest open JD"); five keeps NONE
# meaningful for candidates replying to a slightly older posting while cutting
# the matcher prompt to about a fifth of its size. Raise it if people routinely
# reply to postings older than the last five.
MATCH_JD_LIMIT=5

# Prompt size budget in characters (~4 chars per token). Providers meter tokens
# per minute and reject a single oversized request outright — waiting does not
# help, only sending less does. The matcher is the expensive call: it carries
# every open role plus the candidate's CV.
#
# Groq's free tier allows 8000 TPM, and the reserved output budget counts too,
# so keep LLM_MAX_OUTPUT_TOKENS modest as well. Raise these on a paid tier.
MATCH_PROMPT_CHARS=12000
MATCH_JD_TEXT_CHARS=450
MATCH_CANDIDATE_CHARS=5000
LLM_MAX_OUTPUT_TOKENS=2048

# Stage 1 (routing) gets a much smaller budget than stage 2 on purpose. It
# only decides what a message IS, which its opening lines settle — sending a
# whole 20,000-character CV to answer that is the largest avoidable cost in
# the pipeline.
ROUTER_TEXT_CHARS=3000
ROUTER_CONTEXT_CHARS=2000
ROUTER_CONTEXT_MESSAGE_CHARS=400

# Output budget per stage. Providers reserve max_tokens against tokens-per-
# minute in full, whether or not the model generates that much, so a single
# cap sized for the matcher's evidence array overcharges every routing call.
ROUTER_OUTPUT_TOKENS=512
MATCH_OUTPUT_TOKENS=1024

# ---------------------------------------------------------------------------
# Evolution API (WhatsApp)
# ---------------------------------------------------------------------------
# Point your Evolution instance's messages.upsert webhook at:
#   http://<backend-host>:3001/webhook/whatsapp
# If set, requests must carry this value in x-webhook-token, apikey, or
# Authorization: Bearer. Leave blank to accept unauthenticated webhooks.
EVOLUTION_WEBHOOK_TOKEN=

# Only ingest messages from these chats (comma-separated full JIDs). Evolution
# delivers ALL inbound traffic on the instance, so without this a personal DM
# becomes a candidate row. Leave blank to accept everything.
#   group JID:  120363412324850699@g.us
#   direct JID: 919812345678@s.whatsapp.net
INGEST_ALLOWED_CHATS=

# Migration aid. Evolution allows only ONE webhook URL per instance, so point
# Evolution at this stack and set this to the OLD n8n webhook to run both
# pipelines on identical live traffic. Fire-and-forget: never blocks or fails
# ingest. Unset once n8n is retired.
#   WEBHOOK_FORWARD_URL=http://n8n:5678/webhook/<your-n8n-webhook-id>
WEBHOOK_FORWARD_URL=

# ---------------------------------------------------------------------------
# Attachment extraction (resumes)
# ---------------------------------------------------------------------------
# Evolution sends webhooks with webhookBase64=false, so media must be fetched
# back by message id. Without these, PDFs and DOCX resumes reach the classifier
# as "[document: resume.pdf]" with no text — which is what sends them to review.
EVOLUTION_API_URL=http://evolution_api:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=your-instance-name

# Read-only connection to Evolution's own database, used by scripts/backfill.js
# to replay historical messages that predate this stack. Copy it from
# Evolution's DATABASE_CONNECTION_URI. Only needed for backfills.
EVOLUTION_DB_URL=

# Skip anything larger than this (MB) rather than pulling it into memory.
MEDIA_MAX_MB=15
# Hard cap on extracted characters fed to the classifier.
MEDIA_MAX_CHARS=20000

# Set to 1 while first wiring Evolution up: logs the reason and the raw payload
# whenever a webhook delivery is ignored. Turn it off once messages are flowing —
# it logs full message bodies.
WEBHOOK_DEBUG=0

# ---------------------------------------------------------------------------
# Worker tuning
# ---------------------------------------------------------------------------
WORKER_POLL_MS=5000
WORKER_CLAIM_LIMIT=5
SHEET_SYNC_MS=30000

# ---------------------------------------------------------------------------
# Google Sheets mirror (read-only copy of Postgres)
# ---------------------------------------------------------------------------
# Leave GOOGLE_SHEET_ID blank to disable mirroring entirely.
GOOGLE_SHEET_ID=your_spreadsheet_id_here

# Option A: the whole service account JSON as a string (best for Docker)
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com"}

# Option B: a path to the JSON key file instead
# GOOGLE_SERVICE_ACCOUNT_KEY=/app/service-account.json
# SERVICE_ACCOUNT_KEY_FILE=/path/on/host/to/service-account.json
